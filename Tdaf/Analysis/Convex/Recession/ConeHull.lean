/-- **Rockafellar, Theorem 9.6**, in the form "`cl K = K ∪ 0⁺C`". -/
theorem closure_coe_hull_eq_union (hC : Convex ℝ C) (hCc : IsClosed C) (hne : C.Nonempty)
