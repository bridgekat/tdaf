/-! ### The positively homogeneous convex function generated by a convex function -/

section PosHomGen

variable {E : Type*} [AddCommGroup E] [Module ℝ E] {f g : E → EReal}

/-- **The positively homogeneous convex function generated by `f`** (Rockafellar §5, the paragraph
after Theorem 5.3): the function determined by the convex cone generated by `epi f`.

It is a function on the *same* space as `f`, and is the greatest positively homogeneous convex
`g ≤ f` with `g 0 ≤ 0` (`posHomGen_isGreatest`). It is not `hom f` of `Homogenize.lean`, which is
this operator applied to the level-1 lift of `f` and lives on `ℝ × E`; see that file's design note.
The gauge of a convex set `C` is `posHomGen (δ(· | C) + 1)`, which is what makes Corollary 9.7.1 a
corollary of Theorem 9.7. -/
noncomputable def posHomGen (f : E → EReal) : E → EReal :=
  ofEpi (PointedCone.hull ℝ (epi f) : Set (E × ℝ))

/-- The cone generating `posHomGen f` lies inside its epigraph. -/
theorem coe_hull_epi_subset_epi_posHomGen (f : E → EReal) :
    (PointedCone.hull ℝ (epi f) : Set (E × ℝ)) ⊆ epi (posHomGen f) := subset_epi_ofEpi _

/-- `posHomGen f ≤ f`. -/
theorem posHomGen_le (f : E → EReal) : posHomGen f ≤ f := by
  have h := ofEpi_mono (F := epi f) (G := (PointedCone.hull ℝ (epi f) : Set (E × ℝ)))
    PointedCone.subset_hull
  rwa [ofEpi_epi] at h

/-- `posHomGen f 0 ≤ 0`: the origin lies in the cone generated by `epi f`. -/
theorem posHomGen_apply_zero_le (f : E → EReal) : posHomGen f 0 ≤ 0 := by
  have hmem : (((0 : E), (0 : ℝ)) : E × ℝ) ∈ (PointedCone.hull ℝ (epi f) : Set (E × ℝ)) := by
    rw [Prod.mk_zero_zero]
    exact Submodule.zero_mem _
  have h : posHomGen f 0 ≤ ((0 : ℝ) : EReal) := ofEpi_apply_le hmem
  rwa [_root_.EReal.coe_zero] at h

/-- `posHomGen f` is convex, with no hypothesis on `f`: a cone hull is convex. -/
theorem convexFn_posHomGen (f : E → EReal) : ConvexFn (posHomGen f) :=
  convexFn_ofEpi (PointedCone.hull ℝ (epi f) : ConvexCone ℝ (E × ℝ)).convex

/-- `posHomGen f` is positively homogeneous, with no hypothesis on `f`. -/
theorem posHomogeneous_posHomGen (f : E → EReal) : PosHomogeneous (posHomGen f) := by
  refine posHomogeneous_iff_isCone_epi.2 fun a ha => ?_
  have hsmul : a • (PointedCone.hull ℝ (epi f) : Set (E × ℝ))
      = (PointedCone.hull ℝ (epi f) : Set (E × ℝ)) := by
    refine subset_antisymm ?_ fun x hx => ?_
    · rintro _ ⟨y, hy, rfl⟩
      exact Submodule.smul_mem _ (⟨a, ha.le⟩ : {c : ℝ // 0 ≤ c}) hy
    · refine ⟨a⁻¹ • x, Submodule.smul_mem _ (⟨a⁻¹, (inv_pos.2 ha).le⟩ : {c : ℝ // 0 ≤ c}) hx, ?_⟩
      change a • a⁻¹ • x = x
      rw [smul_smul, mul_inv_cancel₀ (ne_of_gt ha), one_smul]
  rw [posHomGen, smul_epi_ofEpi ha, hsmul]

/-- **The maximality property of `posHomGen f`**: it dominates every positively homogeneous convex
minorant of `f` that is nonpositive at the origin. -/
theorem le_posHomGen (hg : PosHomogeneous g) (hgc : ConvexFn g) (h0 : g 0 ≤ 0) (hle : g ≤ f) :
    g ≤ posHomGen f := by
  refine subset_epi_iff_le_ofEpi.1 fun p hp => ?_
  induction hp using Submodule.span_induction with
  | mem q hq => exact epi_anti hle hq
  | zero => simpa using mk_mem_epi.2 (by simpa using h0 : g 0 ≤ ((0 : ℝ) : EReal))
  | add q r _ _ ihq ihr => exact (hg.epiCone hgc).add_mem ihq ihr
  | smul c q _ ih =>
      rcases eq_or_lt_of_le c.2 with hc | hc
      · have hzero : ((c : ℝ)) • q = (0 : E × ℝ) := by rw [← hc, zero_smul]
        have h0mem : ((0 : E × ℝ)) ∈ epi g := by
          simpa using mk_mem_epi.2 (by simpa using h0 : g 0 ≤ ((0 : ℝ) : EReal))
        rw [← hzero] at h0mem
        exact h0mem
      · exact (hg.epiCone hgc).smul_mem hc ih

/-- **`posHomGen f` is the greatest positively homogeneous convex minorant of `f` vanishing (or
worse) at the origin** — the property that names it. -/
theorem posHomGen_isGreatest (f : E → EReal) :
    IsGreatest {g : E → EReal | PosHomogeneous g ∧ ConvexFn g ∧ g 0 ≤ 0 ∧ g ≤ f} (posHomGen f) :=
  ⟨⟨posHomogeneous_posHomGen f, convexFn_posHomGen f, posHomGen_apply_zero_le f, posHomGen_le f⟩,
    fun _ hg => le_posHomGen hg.1 hg.2.1 hg.2.2.1 hg.2.2.2⟩

end PosHomGen

/-! ### Theorem 9.7 -/

section Thm97

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  {f : E → EReal}

omit [NormedSpace ℝ E] [FiniteDimensional ℝ E] in
/-- `f 0 > 0` says exactly that `epi f` misses the origin, which is Theorem 9.6's hypothesis. -/
theorem zero_notMem_epi (h0 : 0 < f 0) : (0 : E × ℝ) ∉ epi f := by
  intro h
  have h' : f 0 ≤ (0 : EReal) := by simpa using h
  exact absurd h' (not_le.2 h0)

omit [FiniteDimensional ℝ E] in
/-- The union over `λ > 0` of the epigraphs of the functions `fλ` is the set of positive multiples
of `epi f`. -/
theorem iUnion_epi_smulRight (f : E → EReal) :
    (⋃ t > (0 : ℝ), epi (smulRight f t)) = {p : E × ℝ | ∃ t : ℝ, 0 < t ∧ p ∈ t • epi f} := by
  refine Set.ext fun p => ⟨?_, ?_⟩
  · rintro hp
    obtain ⟨t, ht, hmem⟩ := Set.mem_iUnion₂.1 hp
    exact ⟨t, ht, by rwa [← epi_smulRight ht]⟩
  · rintro ⟨t, ht, hmem⟩
    exact Set.mem_iUnion₂.2 ⟨t, ht, by rwa [epi_smulRight ht]⟩

/-- **Rockafellar, Theorem 9.7**, at the level of epigraphs: for a closed proper convex `f` with
`f 0 > 0` the closed convex cone generated by `epi f` is the union of the epigraphs of the
functions `fλ`, `λ > 0`, together with the epigraph of `f0⁺`. -/
theorem closure_coe_hull_epi (hf : ConvexFn f) (hp : Proper f) (hc : IsClosed (epi f))
    (h0 : 0 < f 0) :
    closure (PointedCone.hull ℝ (epi f) : Set (E × ℝ))
      = (⋃ t > (0 : ℝ), epi (smulRight f t)) ∪ epi (recessionFn f) := by
  rw [closure_coe_hull hf.convex_epi hc ((epi_nonempty_iff f).2 hp.dom_nonempty)
      (zero_notMem_epi h0), iUnion_epi_smulRight, epi_recessionFn]

/-- The closed convex cone generated by `epi f` is itself an epigraph: it is closed, and it is
upward closed in the vertical coordinate because each of the two pieces of Theorem 9.7 is. -/
theorem isEpiLike_closure_coe_hull_epi (hf : ConvexFn f) (hp : Proper f) (hc : IsClosed (epi f))
    (h0 : 0 < f 0) :
    IsEpiLike (closure (PointedCone.hull ℝ (epi f) : Set (E × ℝ))) := by
  refine IsEpiLike.of_isClosed (fun x μ ν hμ hμν => ?_) isClosed_closure
  rw [closure_coe_hull_epi hf hp hc h0] at hμ ⊢
  rcases hμ with h | h
  · obtain ⟨t, ht, hmem⟩ := Set.mem_iUnion₂.1 h
    exact Or.inl (Set.mem_iUnion₂.2 ⟨t, ht, (isEpiLike_epi _).mem_of_le hmem hμν⟩)
  · exact Or.inr ((isEpiLike_epi _).mem_of_le h hμν)

/-- **Rockafellar, Theorem 9.7.** For a closed proper convex `f` with `f 0 > 0`, the closure of the
positively homogeneous convex function `k` generated by `f` has

`epi (cl k) = (⋃ {epi (fλ) | λ > 0}) ∪ epi (f0⁺)`.

Reading the identity pointwise gives Rockafellar's formula
`(cl k) x = inf {(fλ) x | λ > 0 or λ = 0⁺}` (`lscHull_posHomGen`); the fact that the right-hand
side is a *union of epigraphs* rather than merely the epigraph of the infimum is exactly the
assertion that the infimum is attained. -/
theorem epi_lscHull_posHomGen (hf : ConvexFn f) (hp : Proper f) (hc : IsClosed (epi f))
    (h0 : 0 < f 0) :
    epi (lscHull (posHomGen f))
      = (⋃ t > (0 : ℝ), epi (smulRight f t)) ∪ epi (recessionFn f) := by
  rw [epi_lscHull, ← closure_coe_hull_epi hf hp hc h0]
  refine subset_antisymm ?_ (closure_mono (coe_hull_epi_subset_epi_posHomGen f))
  refine isClosed_closure.closure_subset_iff.2 ?_
  exact epi_ofEpi_subset_of_isEpiLike subset_closure (isEpiLike_closure_coe_hull_epi hf hp hc h0)

/-- **Rockafellar, Theorem 9.7**, pointwise: `(cl k) x = inf {(fλ) x | λ > 0 or λ = 0⁺}`. -/
theorem lscHull_posHomGen (hf : ConvexFn f) (hp : Proper f) (hc : IsClosed (epi f))
    (h0 : 0 < f 0) :
    lscHull (posHomGen f) = (⨅ t : ℝ, ⨅ _ : (0 : ℝ) < t, smulRight f t) ⊓ recessionFn f := by
  have h := congrArg ofEpi (epi_lscHull_posHomGen hf hp hc h0)
  rw [ofEpi_epi, ofEpi_union, ofEpi_epi] at h
  rw [h, ofEpi_iUnion]
  congr 1
  refine iInf_congr fun t => ?_
  rw [ofEpi_iUnion]
  exact iInf_congr fun _ => ofEpi_epi _

/-- **Rockafellar, Theorem 9.7**, the attainment statement: whenever `(cl k) x` is bounded above by
a real number, that bound is already achieved by some `(fλ) x` with `λ > 0`, or by `(f0⁺) x`. -/
theorem exists_smulRight_le_of_lscHull_posHomGen_le (hf : ConvexFn f) (hp : Proper f)
    (hc : IsClosed (epi f)) (h0 : 0 < f 0) {x : E} {μ : ℝ}
    (hμ : lscHull (posHomGen f) x ≤ (μ : EReal)) :
    (∃ t : ℝ, 0 < t ∧ smulRight f t x ≤ (μ : EReal)) ∨ recessionFn f x ≤ (μ : EReal) := by
  have hmem : ((x, μ) : E × ℝ) ∈ epi (lscHull (posHomGen f)) := mk_mem_epi.2 hμ
  rw [epi_lscHull_posHomGen hf hp hc h0] at hmem
  rcases hmem with h | h
  · obtain ⟨t, ht, hmem'⟩ := Set.mem_iUnion₂.1 h
    exact Or.inl ⟨t, ht, mk_mem_epi.1 hmem'⟩
  · exact Or.inr (mk_mem_epi.1 h)

/-- **Rockafellar, Theorem 9.7**: `k` is proper.

A vertical line in the epigraph of `k` would make `(0, -1)` a direction of recession of the closed
convex cone generated by `epi f`, hence a member of that cone; but by Theorem 9.6 that would force
either `f 0 < 0` or `(f0⁺) 0 ≤ -1`, and both are excluded. -/
theorem proper_posHomGen (hf : ConvexFn f) (hp : Proper f) (hc : IsClosed (epi f))
    (h0 : 0 < f 0) : Proper (posHomGen f) := by
  refine ⟨?_, fun x hbot => ?_⟩
  · obtain ⟨x, hx⟩ := hp.dom_nonempty
    exact ⟨x, lt_of_le_of_lt (posHomGen_le f x) hx⟩
  · set S : Set (E × ℝ) := closure (PointedCone.hull ℝ (epi f) : Set (E × ℝ)) with hS
    have hSconv : Convex ℝ S :=
      ((PointedCone.hull ℝ (epi f) : ConvexCone ℝ (E × ℝ)).convex).closure
    have hline : ∀ μ : ℝ, ((x, μ) : E × ℝ) ∈ S :=
      fun μ => epi_ofEpi_subset_of_isEpiLike subset_closure
        (isEpiLike_closure_coe_hull_epi hf hp hc h0)
        (mk_mem_epi.2 (le_of_eq_of_le hbot bot_le))
    have hray : (((0 : E), (-1 : ℝ)) : E × ℝ) ∈ recessionCone S := by
      refine mem_recessionCone_of_exists_ray hSconv isClosed_closure ⟨((x, (0 : ℝ)) : E × ℝ),
        fun a ha => ?_⟩
      have heq : ((x, (0 : ℝ)) : E × ℝ) + a • (((0 : E), (-1 : ℝ)) : E × ℝ)
          = ((x, -a) : E × ℝ) := by simp [Prod.smul_mk, Prod.mk_add_mk]
      rw [heq]
      exact hline (-a)
    rw [hS, recessionCone_closure_coe_pointedCone, ← hS] at hray
    rw [hS, closure_coe_hull_eq_union hf.convex_epi hc
      ((epi_nonempty_iff f).2 hp.dom_nonempty) (zero_notMem_epi h0)] at hray
    rcases hray with hmem | hmem
    · rw [coe_hull_of_convex hf.convex_epi] at hmem
      rcases hmem with heq | ⟨t, ht, q, hq, hqp⟩
      · exact absurd (congrArg Prod.snd heq) (by norm_num)
      · have hqp' : t • q = (((0 : E), (-1 : ℝ)) : E × ℝ) := hqp
        have h2 : t * q.2 = -1 := congrArg Prod.snd hqp'
        have h1 : t • q.1 = (0 : E) := congrArg Prod.fst hqp'
        have hq1 : q.1 = 0 := by
          rcases smul_eq_zero.1 h1 with h | h
          · exact absurd h (ne_of_gt ht)
          · exact h
        have hle : f 0 ≤ ((q.2 : ℝ) : EReal) := by rw [← hq1]; exact mk_mem_epi.1 hq
        have hneg : q.2 < 0 := by nlinarith
        have : ((q.2 : ℝ) : EReal) < 0 := by
          rw [← EReal.coe_zero]
          exact_mod_cast hneg
        exact absurd (lt_of_lt_of_le h0 hle) (not_lt.2 this.le)
    · rw [← epi_recessionFn] at hmem
      have hle : recessionFn f 0 ≤ ((-1 : ℝ) : EReal) := mk_mem_epi.1 hmem
      rw [recessionFn_apply_zero hp] at hle
      exact absurd hle (by norm_num)

omit [FiniteDimensional ℝ E] in
/-- The function determined by `⋃ {epi (fλ) | λ > 0}` is the infimum of the `fλ` over `λ > 0`. -/
theorem ofEpi_iUnion_epi_smulRight (f : E → EReal) :
    ofEpi (⋃ t > (0 : ℝ), epi (smulRight f t)) = ⨅ t : ℝ, ⨅ _ : (0 : ℝ) < t, smulRight f t := by
  rw [ofEpi_iUnion]
  refine iInf_congr fun t => ?_
  rw [ofEpi_iUnion]
  exact iInf_congr fun _ => ofEpi_epi _

omit [FiniteDimensional ℝ E] in
/-- **The estimate behind the last sentence of Theorem 9.7.** When `0 ∈ dom f`, the half-line
`(0, f 0) + a (z, ν)` stays in `epi f` for every `(z, ν) ∈ 0⁺(epi f)`, so `(fλ) z ≤ λ f 0 + ν` for
`λ = 1/a`; letting `a → ∞` puts `(z, ν)` in the epi-closure of `⋃ {epi (fλ) | λ > 0}`. This is why
the term `λ = 0⁺` can then be dropped from the infimum. -/
theorem recessionCone_epi_subset_epi_ofEpi_iUnion (hp : Proper f) (hdom : f 0 ≠ ⊤) :
    recessionCone (epi f) ⊆ epi (ofEpi (⋃ t > (0 : ℝ), epi (smulRight f t))) := by
  obtain ⟨r, hr⟩ := Tdaf.EReal.exists_coe_of_ne_bot_of_lt_top (hp.ne_bot 0)
    (lt_top_iff_ne_top.2 hdom)
  have hrmem : (((0 : E), r) : E × ℝ) ∈ epi f := mk_mem_epi.2 hr.le
  rintro ⟨z, ν⟩ hzν
  refine (isEpiLike_epi _).mem_of_forall_lt fun ρ hρ => ?_
  set a : ℝ := |r| / (ρ - ν) + 1 with ha
  have hρν : 0 < ρ - ν := by linarith
  have hapos : 0 < a := by positivity
  have hlt : r / a < ρ - ν := by
    rw [div_lt_iff₀ hapos, ha]
    have h1 : |r| / (ρ - ν) * (ρ - ν) = |r| := div_mul_cancel₀ _ (ne_of_gt hρν)
    nlinarith [le_abs_self r, abs_nonneg r]
  have hmem : ((a • z, r + a * ν) : E × ℝ) ∈ epi f := by
    have hstep := add_smul_mem_of_mem_recessionCone hzν hrmem hapos.le
    simpa [Prod.smul_mk, Prod.mk_add_mk, smul_eq_mul] using hstep
  have heq : (a⁻¹ : ℝ) • ((a • z, r + a * ν) : E × ℝ) = ((z, r / a + ν) : E × ℝ) := by
    have hz : (a⁻¹ : ℝ) • (a • z) = z := by
      rw [smul_smul, inv_mul_cancel₀ (ne_of_gt hapos), one_smul]
    have hn : a⁻¹ * (r + a * ν) = r / a + ν := by field_simp
    rw [Prod.smul_mk, hz, smul_eq_mul, hn]
  have hsmul : ((z, r / a + ν) : E × ℝ) ∈ epi (smulRight f a⁻¹) := by
    rw [epi_smulRight (inv_pos.2 hapos), ← heq]
    exact Set.smul_mem_smul_set hmem
  have hle : ofEpi (⋃ t > (0 : ℝ), epi (smulRight f t)) z ≤ ((r / a + ν : ℝ) : EReal) :=
    ofEpi_apply_le (Set.mem_iUnion₂.2 ⟨a⁻¹, inv_pos.2 hapos, hsmul⟩)
  refine mk_mem_epi.2 (hle.trans ?_)
  exact_mod_cast (by linarith : r / a + ν ≤ ρ)

omit [FiniteDimensional ℝ E] in
/-- `⋃ {epi (fλ) | λ > 0}` sits inside the convex cone generated by `epi f`. -/
theorem iUnion_epi_smulRight_subset_coe_hull (hf : ConvexFn f) :
    (⋃ t > (0 : ℝ), epi (smulRight f t)) ⊆ (PointedCone.hull ℝ (epi f) : Set (E × ℝ)) := by
  rw [iUnion_epi_smulRight, coe_hull_of_convex hf.convex_epi]
  exact Set.subset_insert _ _

/-- **Rockafellar, Theorem 9.7**, the case `0 ∈ dom f`: the epigraph of `k` is already the *closed*
convex cone generated by `epi f`, so `k` is closed (`lscHull_posHomGen_eq`) and `λ = 0⁺` may be
dropped from the infimum (`posHomGen_eq_iInf_smulRight`). -/
theorem epi_posHomGen_of_zero_mem_dom (hf : ConvexFn f) (hp : Proper f) (hc : IsClosed (epi f))
    (h0 : 0 < f 0) (hdom : f 0 ≠ ⊤) :
    epi (posHomGen f) = closure (PointedCone.hull ℝ (epi f) : Set (E × ℝ)) := by
  have hmono : epi (ofEpi (⋃ t > (0 : ℝ), epi (smulRight f t))) ⊆ epi (posHomGen f) :=
    epi_anti (ofEpi_mono (iUnion_epi_smulRight_subset_coe_hull hf))
  refine subset_antisymm
    (epi_ofEpi_subset_of_isEpiLike subset_closure (isEpiLike_closure_coe_hull_epi hf hp hc h0))
    ?_
  rw [closure_coe_hull_epi hf hp hc h0]
  refine Set.union_subset
    ((iUnion_epi_smulRight_subset_coe_hull hf).trans (coe_hull_epi_subset_epi_posHomGen f)) ?_
  rw [epi_recessionFn]
  exact (recessionCone_epi_subset_epi_ofEpi_iUnion hp hdom).trans hmono

/-- **Rockafellar, Theorem 9.7**, the case `0 ∈ dom f`: `k` is itself closed. -/
theorem lscHull_posHomGen_eq (hf : ConvexFn f) (hp : Proper f) (hc : IsClosed (epi f))
    (h0 : 0 < f 0) (hdom : f 0 ≠ ⊤) : lscHull (posHomGen f) = posHomGen f := by
  refine epi_injective ?_
  rw [epi_lscHull, epi_posHomGen_of_zero_mem_dom hf hp hc h0 hdom, closure_closure]

/-- **Rockafellar, Theorem 9.7**, the case `0 ∈ dom f`: the term `λ = 0⁺` may be dropped, and
`k x = inf {(fλ) x | λ > 0}` — although the infimum then need not be attained. -/
theorem posHomGen_eq_iInf_smulRight (hf : ConvexFn f) (hp : Proper f) (hc : IsClosed (epi f))
    (h0 : 0 < f 0) (hdom : f 0 ≠ ⊤) :
    posHomGen f = ⨅ t : ℝ, ⨅ _ : (0 : ℝ) < t, smulRight f t := by
  rw [← ofEpi_iUnion_epi_smulRight]
  refine epi_injective (subset_antisymm ?_
    (epi_anti (ofEpi_mono (iUnion_epi_smulRight_subset_coe_hull hf))))
  rw [epi_posHomGen_of_zero_mem_dom hf hp hc h0 hdom, closure_coe_hull_epi hf hp hc h0]
  refine Set.union_subset (subset_epi_ofEpi _) ?_
  rw [epi_recessionFn]
  exact recessionCone_epi_subset_epi_ofEpi_iUnion hp hdom

end Thm97

/-! ### Theorem 9.8 -/

section UnionOfSets

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  {C D : Set E}

/-- **The key step of Theorem 9.8.** Under Rockafellar's recession hypothesis the sum of the closed
cones over `C` and over `D` is the closure of a convex cone — hence closed, hence its own recession
cone. This is Corollary 9.1.3 applied to the two cones one dimension up; the hypothesis transports
because a cancelling pair in the sum must have both homogenising coordinates zero. -/
theorem closedConeOver_add_eq_closure_coe_sup
    (hC : Convex ℝ C) (hCc : IsClosed C) (hCne : C.Nonempty)
    (hD : Convex ℝ D) (hDc : IsClosed D) (hDne : D.Nonempty)
    (h : ∀ z ∈ recessionCone C, ∀ w ∈ recessionCone D, z + w = 0 →
      z ∈ linealitySpace C ∧ w ∈ linealitySpace D) :
    closedConeOver C + closedConeOver D
      = closure ((PointedCone.hull ℝ (Prod.mk (1 : ℝ) '' C)
          ⊔ PointedCone.hull ℝ (Prod.mk (1 : ℝ) '' D) : PointedCone ℝ (ℝ × E)) : Set (ℝ × E)) := by
  have hcl₁ : closure (PointedCone.hull ℝ (Prod.mk (1 : ℝ) '' C) : Set (ℝ × E))
      = closedConeOver C := closure_coe_hull_prodMk_one hC hCc hCne
  have hcl₂ : closure (PointedCone.hull ℝ (Prod.mk (1 : ℝ) '' D) : Set (ℝ × E))
      = closedConeOver D := closure_coe_hull_prodMk_one hD hDc hDne
  have hrec₁ : recessionCone (closedConeOver C) = closedConeOver C := by
    rw [← hcl₁]; exact recessionCone_closure_coe_pointedCone _
  have hrec₂ : recessionCone (closedConeOver D) = closedConeOver D := by
    rw [← hcl₂]; exact recessionCone_closure_coe_pointedCone _
  have hkey : ∀ z ∈ closure (PointedCone.hull ℝ (Prod.mk (1 : ℝ) '' C) : Set (ℝ × E)),
      ∀ w ∈ closure (PointedCone.hull ℝ (Prod.mk (1 : ℝ) '' D) : Set (ℝ × E)), z + w = 0 →
      z ∈ linealitySpace (closure (PointedCone.hull ℝ (Prod.mk (1 : ℝ) '' C) : Set (ℝ × E))) ∧
        w ∈ linealitySpace
          (closure (PointedCone.hull ℝ (Prod.mk (1 : ℝ) '' D) : Set (ℝ × E))) := by
    rw [hcl₁, hcl₂]
    intro z hz w hw hzw
    have h1 : z.1 + w.1 = 0 := congrArg Prod.fst hzw
    have h2 : z.2 + w.2 = 0 := congrArg Prod.snd hzw
    have hz0 := fst_nonneg_of_mem_closedConeOver hz
    have hw0 := fst_nonneg_of_mem_closedConeOver hw
    have hz1 : z.1 = 0 := by linarith
    have hw1 : w.1 = 0 := by linarith
    have hzrec : z.2 ∈ recessionCone C := by
      rcases mem_closedConeOver.1 hz with ⟨hpos, -⟩ | ⟨-, hh⟩
      · exact absurd hz1 (ne_of_gt hpos)
      · exact hh
    have hwrec : w.2 ∈ recessionCone D := by
      rcases mem_closedConeOver.1 hw with ⟨hpos, -⟩ | ⟨-, hh⟩
      · exact absurd hw1 (ne_of_gt hpos)
      · exact hh
    obtain ⟨hzl, hwl⟩ := h z.2 hzrec w.2 hwrec h2
    constructor
    · refine mem_linealitySpace.2 ⟨?_, ?_⟩
      · rw [hrec₁]; exact mem_closedConeOver.2 (Or.inr ⟨hz1, hzrec⟩)
      · rw [hrec₁]
        refine mem_closedConeOver.2 (Or.inr ⟨?_, ?_⟩)
        · change -z.1 = 0
          rw [hz1, neg_zero]
        · exact (mem_linealitySpace.1 hzl).2
    · refine mem_linealitySpace.2 ⟨?_, ?_⟩
      · rw [hrec₂]; exact mem_closedConeOver.2 (Or.inr ⟨hw1, hwrec⟩)
      · rw [hrec₂]
        refine mem_closedConeOver.2 (Or.inr ⟨?_, ?_⟩)
        · change -w.1 = 0
          rw [hw1, neg_zero]
        · exact (mem_linealitySpace.1 hwl).2
  rw [Submodule.coe_sup, closure_add_coe_pointedCone _ _ hkey, hcl₁, hcl₂]

/-- **Rockafellar, Theorem 9.8.** Let `C` and `D` be nonempty closed convex sets such that the only
way a direction of recession of `C` and a direction of recession of `D` can cancel is inside the
two lineality spaces. Then

`cl (conv (C ∪ D)) = conv (C ∪ D) + (0⁺C + 0⁺D)`  and  `0⁺(cl (conv (C ∪ D))) = 0⁺C + 0⁺D`.

Rockafellar writes the right-hand side of the first identity as
`⋃ {λ₁C + λ₂D | λᵢ ≥ 0⁺, λ₁ + λ₂ = 1}`, with the convention that `0 · C` means `0⁺C`; the form
here says the same thing without the convention, and is the one `Polyhedral/Ops.lean` already uses
for Theorem 19.6.

Stated for two sets; the `m`-set version is the evident induction and no backbone result asks for
it. Both sets have to be nonempty — `0⁺∅` is everything.

The two conclusions are packaged together because they come from one application of Corollary
9.1.3, read off the level-one and the level-zero slice of the same sum of cones. -/
theorem closure_convexHull_union_and_recessionCone
    (hC : Convex ℝ C) (hCc : IsClosed C) (hCne : C.Nonempty)
    (hD : Convex ℝ D) (hDc : IsClosed D) (hDne : D.Nonempty)
    (h : ∀ z ∈ recessionCone C, ∀ w ∈ recessionCone D, z + w = 0 →
      z ∈ linealitySpace C ∧ w ∈ linealitySpace D) :
    closure (convexHull ℝ (C ∪ D))
        = convexHull ℝ (C ∪ D) + (recessionCone C + recessionCone D) ∧
      recessionCone (closure (convexHull ℝ (C ∪ D))) = recessionCone C + recessionCone D := by
  have hsum := closedConeOver_add_eq_closure_coe_sup hC hCc hCne hD hDc hDne h
  have hSconv : Convex ℝ (closedConeOver C + closedConeOver D) :=
    (convex_closedConeOver hC hCc hCne).add (convex_closedConeOver hD hDc hDne)
  have hSclosed : IsClosed (closedConeOver C + closedConeOver D) := by
    rw [hsum]; exact isClosed_closure
  have hTclosed : IsClosed ((Prod.mk (1 : ℝ)) ⁻¹' (closedConeOver C + closedConeOver D)) :=
    hSclosed.preimage (by fun_prop)
  have hTconv : Convex ℝ ((Prod.mk (1 : ℝ)) ⁻¹' (closedConeOver C + closedConeOver D)) := by
    intro x hx y hy a b ha hb hab
    have heq : (((1 : ℝ), a • x + b • y) : ℝ × E)
        = a • (((1 : ℝ), x) : ℝ × E) + b • (((1 : ℝ), y) : ℝ × E) := by
      simp [Prod.smul_mk, Prod.mk_add_mk, smul_eq_mul, hab]
    change (((1 : ℝ), a • x + b • y) : ℝ × E) ∈ closedConeOver C + closedConeOver D
    rw [heq]
    exact hSconv hx hy ha hb hab
  have hCT : C ⊆ (Prod.mk (1 : ℝ)) ⁻¹' (closedConeOver C + closedConeOver D) := by
    intro x hx
    exact ⟨((1 : ℝ), x), mem_closedConeOver.2 (Or.inl ⟨one_pos, ⟨x, hx, one_smul ℝ x⟩⟩),
      0, zero_mem_closedConeOver D, add_zero _⟩
  have hDT : D ⊆ (Prod.mk (1 : ℝ)) ⁻¹' (closedConeOver C + closedConeOver D) := by
    intro x hx
    exact ⟨0, zero_mem_closedConeOver C,
      ((1 : ℝ), x), mem_closedConeOver.2 (Or.inl ⟨one_pos, ⟨x, hx, one_smul ℝ x⟩⟩), zero_add _⟩
  have hclT : closure (convexHull ℝ (C ∪ D))
      ⊆ (Prod.mk (1 : ℝ)) ⁻¹' (closedConeOver C + closedConeOver D) :=
    hTclosed.closure_subset_iff.2 (convexHull_min (Set.union_subset hCT hDT) hTconv)
  have hTsub : (Prod.mk (1 : ℝ)) ⁻¹' (closedConeOver C + closedConeOver D)
      ⊆ convexHull ℝ (C ∪ D) + (recessionCone C + recessionCone D) := by
    intro x hx
    exact mem_convexHull_add_of_mk_one_mem (Set.mem_preimage.1 hx)
  have hrec : ∀ {S : Set E}, S.Nonempty → S ⊆ closure (convexHull ℝ (C ∪ D)) →
      recessionCone S ⊆ recessionCone (closure (convexHull ℝ (C ∪ D))) := by
    intro S hSne hSsub y hy
    obtain ⟨x, hx⟩ := hSne
    exact mem_recessionCone_of_exists_ray ((convex_convexHull ℝ _).closure) isClosed_closure
      ⟨x, fun a ha => hSsub (hy x hx a ha)⟩
  have hinC : C ⊆ closure (convexHull ℝ (C ∪ D)) :=
    fun z hz => subset_closure (subset_convexHull ℝ _ (Or.inl hz))
  have hinD : D ⊆ closure (convexHull ℝ (C ∪ D)) :=
    fun z hz => subset_closure (subset_convexHull ℝ _ (Or.inr hz))
  have hfinal : convexHull ℝ (C ∪ D) + (recessionCone C + recessionCone D)
      ⊆ closure (convexHull ℝ (C ∪ D)) := by
    rintro x ⟨u, hu, v, hv, huv⟩
    have huv' : u + v = x := huv
    obtain ⟨z, hz, w, hw, hzw⟩ := hv
    have hzw' : z + w = v := hzw
    have h1 := add_mem_of_mem_recessionCone (hrec hCne hinC hz) (subset_closure hu)
    have h2 := add_mem_of_mem_recessionCone (hrec hDne hinD hw) h1
    have heq : u + z + w = x := by rw [← huv', ← hzw']; abel
    rwa [heq] at h2
  have hTeq : (Prod.mk (1 : ℝ)) ⁻¹' (closedConeOver C + closedConeOver D)
      = closure (convexHull ℝ (C ∪ D)) := subset_antisymm (hTsub.trans hfinal) hclT
  refine ⟨subset_antisymm (hclT.trans hTsub) hfinal, subset_antisymm (fun y hy => ?_) ?_⟩
  · obtain ⟨x, hx⟩ := hCne
    have hray : (((0 : ℝ), y) : ℝ × E)
        ∈ recessionCone (closedConeOver C + closedConeOver D) := by
      refine mem_recessionCone_of_exists_ray hSconv hSclosed ⟨(((1 : ℝ), x) : ℝ × E),
        fun a ha => ?_⟩
      have heq : (((1 : ℝ), x) : ℝ × E) + a • (((0 : ℝ), y) : ℝ × E)
          = (((1 : ℝ), x + a • y) : ℝ × E) := by simp [Prod.smul_mk, Prod.mk_add_mk]
      rw [heq, ← Set.mem_preimage, hTeq]
      exact hy x (hinC hx) a ha
    rw [hsum, recessionCone_closure_coe_pointedCone, ← hsum] at hray
    exact mem_recessionCone_add_of_mk_zero_mem hray
  · rintro y ⟨z, hz, w, hw, hzw⟩
    have hzw' : z + w = y := hzw
    rw [← hzw']
    exact add_mem_recessionCone (hrec hCne hinC hz) (hrec hDne hinD hw)

/-- **Rockafellar, Theorem 9.8**, the closure formula. -/
theorem closure_convexHull_union
    (hC : Convex ℝ C) (hCc : IsClosed C) (hCne : C.Nonempty)
    (hD : Convex ℝ D) (hDc : IsClosed D) (hDne : D.Nonempty)
    (h : ∀ z ∈ recessionCone C, ∀ w ∈ recessionCone D, z + w = 0 →
      z ∈ linealitySpace C ∧ w ∈ linealitySpace D) :
    closure (convexHull ℝ (C ∪ D))
      = convexHull ℝ (C ∪ D) + (recessionCone C + recessionCone D) :=
  (closure_convexHull_union_and_recessionCone hC hCc hCne hD hDc hDne h).1

/-- **Rockafellar, Theorem 9.8**, the recession-cone formula. -/
theorem recessionCone_closure_convexHull_union
    (hC : Convex ℝ C) (hCc : IsClosed C) (hCne : C.Nonempty)
    (hD : Convex ℝ D) (hDc : IsClosed D) (hDne : D.Nonempty)
    (h : ∀ z ∈ recessionCone C, ∀ w ∈ recessionCone D, z + w = 0 →
      z ∈ linealitySpace C ∧ w ∈ linealitySpace D) :
    recessionCone (closure (convexHull ℝ (C ∪ D))) = recessionCone C + recessionCone D :=
  (closure_convexHull_union_and_recessionCone hC hCc hCne hD hDc hDne h).2

omit [FiniteDimensional ℝ E] in
/-- Directions of recession survive taking the convex hull: a translation carrying `S` into `S`
carries `conv S` into `conv S`. -/
theorem recessionCone_subset_recessionCone_convexHull (S : Set E) :
    recessionCone S ⊆ recessionCone (convexHull ℝ S) := by
  intro y hy x hx a ha
  have hconv : Convex ℝ ((fun z : E => z + a • y) ⁻¹' convexHull ℝ S) := by
    intro u hu v hv b c hb hc hbc
    have hsplit : b • (a • y) + c • (a • y) = a • y := by rw [← add_smul, hbc, one_smul]
    have heq : b • (u + a • y) + c • (v + a • y) = b • u + c • v + a • y := by
      rw [smul_add, smul_add, add_add_add_comm, hsplit]
    change b • u + c • v + a • y ∈ convexHull ℝ S
    rw [← heq]
    exact convex_convexHull ℝ S hu hv hb hc hbc
  refine convexHull_min (fun s hs => ?_) hconv hx
  change s + a • y ∈ convexHull ℝ S
  exact subset_convexHull ℝ S (hy s hs a ha)

omit [FiniteDimensional ℝ E] in
/-- A recession cone absorbs itself: it contains `0` and is closed under addition. -/
theorem recessionCone_add_self (C : Set E) :
    recessionCone C + recessionCone C = recessionCone C := by
  refine subset_antisymm ?_ fun y hy => ⟨y, hy, 0, zero_mem_recessionCone C, add_zero y⟩
  rintro x ⟨u, hu, v, hv, huv⟩
  have huv' : u + v = x := huv
  rw [← huv']
  exact add_mem_recessionCone hu hv

/-- **Rockafellar, Corollary 9.8.1.** The convex hull of the union of two nonempty closed convex
sets with the *same* recession cone `K` is closed, and has `K` as its recession cone.

The hypothesis of Theorem 9.8 is automatic here: if `z ∈ K` and `-z ∈ K` then `z` lies in the
lineality space of both sets. -/
theorem isClosed_convexHull_union_of_recessionCone_eq
    (hC : Convex ℝ C) (hCc : IsClosed C) (hCne : C.Nonempty)
    (hD : Convex ℝ D) (hDc : IsClosed D) (hDne : D.Nonempty)
    (heq : recessionCone C = recessionCone D) :
    IsClosed (convexHull ℝ (C ∪ D)) ∧
      recessionCone (convexHull ℝ (C ∪ D)) = recessionCone C := by
  have hkey : ∀ z ∈ recessionCone C, ∀ w ∈ recessionCone D, z + w = 0 →
      z ∈ linealitySpace C ∧ w ∈ linealitySpace D := by
    intro z hz w hw hzw
    have hw' : w = -z := by rw [eq_neg_iff_add_eq_zero, add_comm]; exact hzw
    subst hw'
    refine ⟨mem_linealitySpace.2 ⟨hz, by rw [heq]; exact hw⟩, mem_linealitySpace.2 ⟨hw, ?_⟩⟩
    rw [neg_neg, ← heq]
    exact hz
  have hunion : recessionCone C ⊆ recessionCone (C ∪ D) := by
    intro y hy x hx a ha
    have hyD : y ∈ recessionCone D := by rw [← heq]; exact hy
    rcases hx with hx | hx
    · exact Or.inl (hy x hx a ha)
    · exact Or.inr (hyD x hx a ha)
  have hrec : recessionCone C ⊆ recessionCone (convexHull ℝ (C ∪ D)) :=
    hunion.trans (recessionCone_subset_recessionCone_convexHull (C ∪ D))
  have hcl := closure_convexHull_union hC hCc hCne hD hDc hDne hkey
  have hself : recessionCone C + recessionCone D = recessionCone C := by
    rw [← heq]
    exact recessionCone_add_self C
  have hstable : convexHull ℝ (C ∪ D) + (recessionCone C + recessionCone D)
      ⊆ convexHull ℝ (C ∪ D) := by
    rw [hself]
    rintro x ⟨u, hu, v, hv, huv⟩
    have huv' : u + v = x := huv
    rw [← huv']
    exact add_mem_of_mem_recessionCone (hrec hv) hu
  have hclosed : IsClosed (convexHull ℝ (C ∪ D)) := by
    rw [← closure_eq_iff_isClosed, hcl]
    exact subset_antisymm hstable fun x hx =>
      ⟨x, hx, 0, ⟨0, zero_mem_recessionCone C, 0, zero_mem_recessionCone D, add_zero 0⟩, add_zero x⟩
  refine ⟨hclosed, ?_⟩
  have hrec2 := recessionCone_closure_convexHull_union hC hCc hCne hD hDc hDne hkey
  rw [hclosed.closure_eq, hself] at hrec2
  exact hrec2

end UnionOfSets





